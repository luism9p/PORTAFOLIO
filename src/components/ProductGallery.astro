---
import Img from './Img.astro';
import manifest from '../data/image-manifest.json';
import { galleryViews } from '../lib/products';
// La foto se ve siempre completa. Escritorio: alto de pantalla, miniaturas verticales encima del fondo y fade.
// Móvil: carrusel 4:5 con swipe y miniaturas en fila debajo.
const { product } = Astro.props;
const { nombre, tipoDetalle, imagenes } = product;
const views = galleryViews.map((v, i) => ({
  ...v,
  i,
  base: imagenes ? imagenes[v.key] : null,
  alt: `${nombre}, ${tipoDetalle}: ${v.label}`,
}));
// color de los bordes de cada foto (scripts/optimize-images.mjs), para los costados que quedan libres
const backdrop = (base: string | null) => (base && manifest[base]?.backdrop ? `--backdrop: ${manifest[base].backdrop}` : undefined);
---
<div class="gal" data-gallery aria-roledescription="galería de imágenes" aria-label={`Imágenes de ${nombre}`}>
  <div class="gal__stage">
    <div class="gal__slides" data-slides tabindex="0">
      {views.map((v) => (
        <figure class:list={['gal__slide', { 'is-active': v.i === 0 }]} data-index={v.i} style={backdrop(v.base)}>
          {v.base
            ? <Img base={v.base} alt={v.alt} eager={v.i === 0} sizes="(min-width: 900px) 52vw, 100vw" />
            : <div class="ph" role="img" aria-label={v.alt}><span class="ph__name">{nombre.toLowerCase()}</span><span class="ph__view">{v.label}</span></div>}
        </figure>
      ))}
    </div>
  </div>
  <div class="gal__thumbs">
    {views.map((v) => (
      <button class:list={['gal__thumb', { 'is-active': v.i === 0 }]} type="button" data-index={v.i} aria-label={`Ver ${v.label}`} aria-pressed={v.i === 0 ? 'true' : 'false'}>
        {v.base
          ? <Img base={v.base} alt="" sizes="64px" />
          : <span class="ph ph--thumb" aria-hidden="true">{v.i + 1}</span>}
      </button>
    ))}
  </div>
</div>
