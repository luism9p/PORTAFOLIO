---
import { waDigits, waLink } from '../lib/links';
import { hasPrice, formatPrice, interestMessage, orderMessage, priceMessage } from '../lib/products';
// Tarjeta de información de la ficha: etiqueta, nombre, precio, descripción, ficha, variantes y botones.
const { product } = Astro.props;
const { nombre, tipoDetalle, etiqueta, precio, precioAnterior, descripcion, material, alto_mm, luz, variantes } = product;
const opciones = variantes?.opciones ?? [];
const first = opciones[0];
const waHref = waLink(orderMessage(product));
const priced = hasPrice(product);
const consultHref = waDigits ? `https://wa.me/${waDigits}?text=${encodeURIComponent(priceMessage(product))}` : '';
---
<section class="pinfo card-box" data-product={product.slug} data-msg={interestMessage(product)} data-variant-label={variantes?.etiqueta ?? ''} data-wa={waDigits}>
  {etiqueta && <p class="pinfo__tag">{etiqueta.toLowerCase()}</p>}
  <h1 class="pinfo__name">{nombre}</h1>
  <p class="pinfo__type">{tipoDetalle}</p>

  <p class="pinfo__price">
    {priced
      ? <><span class="pinfo__now">{formatPrice(precio)}</span>{precioAnterior && <s class="pinfo__was">{formatPrice(precioAnterior)}</s>}</>
      : consultHref
        ? <a class="pinfo__consult" data-wa-ubicacion="producto_precio" href={consultHref} target="_blank" rel="noopener">consultar precio</a>
        : <span class="pinfo__pending">consultar precio</span>}
  </p>

  <p class="pinfo__desc">{descripcion}</p>

  <dl class="pinfo__specs">
    <div><dt>material:</dt><dd>{material}</dd></div>
    <div><dt>medidas:</dt><dd>alto {alto_mm} mm</dd></div>
    {luz && <div><dt>luz:</dt><dd>{luz}</dd></div>}
  </dl>

  {opciones.length > 0 && (
    <fieldset class="variants" data-variants>
      <legend class="variants__legend">{variantes.etiqueta}: <span data-variant-name>{first.nombre}</span></legend>
      <div class="variants__list">
        {opciones.map((o, i) => (
          <label class="variant">
            <input type="radio" name="variante" value={o.nombre} checked={i === 0} />
            <span class="variant__dot" style={`--c:${o.color}`} title={`${o.nombre} (${o.detalle})`}></span>
            <span class="variant__name">{o.nombre}</span>
          </label>
        ))}
      </div>
    </fieldset>
  )}

  <a class="pbtn pbtn--primary" data-wa-link data-wa-ubicacion="ficha" href={waHref || undefined} target={waHref ? '_blank' : undefined} rel={waHref ? 'noopener' : undefined} aria-disabled={waHref ? undefined : 'true'}>pedir por whatsapp</a>
</section>
