---
import Img from './Img.astro';
---
<article class="card card--feature">
  <Img class="feature__img" base="destacado/coleccion-lobitos" alt="Colección Lobitos: lámparas y jarrones sobre fondo beige" sizes="(min-width: 1280px) 20vw, (min-width: 900px) 30vw, 72vw" />
  <div class="feature__content">
    <p class="feature__title">
      <span class="feature__sans">Colección Lobitos |</span>
      <span class="serif">Hecho en 3D, a tu medida</span>
    </p>
    <a class="btn btn--white" href="#productos" data-ver-coleccion="tarjeta_coleccion">Ver colección</a>
  </div>
</article>
