---
import Icons from './Icons.astro';
import { waLink, site } from '../lib/links';
const href = waLink(site.mensajeInfo);
---
{href && (
  <a class="wa" data-wa-ubicacion="flotante" href={href} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
    <Icons name="whatsapp" size={22} />
    <span>WhatsApp</span>
  </a>
)}
