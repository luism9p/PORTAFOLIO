---
import Img from './Img.astro';
---
<section class="hero">
  <Img class="hero__img" base="hero/hero" alt="Lámparas y un jarrón impresos en 3D sobre una mesa, con una cinta de lino" sizes="100vw" eager />
  <div class="hero__content">
    <h1 class="hero__title">
      <span class="hero__title-sans">LUZ CON FORMA</span>
      <span class="serif">Colección impresa en 3D</span>
    </h1>
    <p class="hero__text">Lámparas y objetos de diseño hechos en Lobitos, a tu medida.</p>
    <a class="btn btn--dark" href="#edicion-limitada" data-ver-coleccion="hero">Ver colección</a>
  </div>
</section>
