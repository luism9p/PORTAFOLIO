---
import Img from './Img.astro';
import Icons from './Icons.astro';
import { hasPrice, formatPrice, productUrl } from '../lib/products';
// hover: foto que aparece al pasar el mouse (home: "medidas"; relacionados de la ficha: "ambiente").
// lower: título y precio en minúsculas tipo oración (ficha de producto).
const { product, hover = 'medidas', lower = false } = Astro.props;
const { nombre, tipo, alto_mm, etiqueta, precio, imagenes, slug } = product;
const sizes = '(min-width: 1280px) 20vw, (min-width: 900px) 30vw, 72vw';
---
<article class:list={['card', { 'card--lower': lower }]} data-slug={slug}>
  <div class="card__media">
    <a class="card__link" href={productUrl(slug)} aria-label={`${nombre}, ${tipo.toLowerCase()} de ${alto_mm} mm`}>
      <Img class="card__img card__img--main" base={imagenes.tarjeta} alt={`${nombre}: ${tipo.toLowerCase()} impresa en 3D`} sizes={sizes} />
      <Img class="card__img card__img--alt" base={imagenes[hover]} alt="" sizes={sizes} />
    </a>
    {etiqueta && <span class="tag">{lower ? etiqueta.toLowerCase() : etiqueta}</span>}
    <button class="card__bag" type="button" aria-label={`Añadir ${nombre} a la bolsa`}><Icons name="bag" size={18} /></button>
  </div>
  <div class="card__info">
    <div class="card__row">
      <h3 class="card__name">{lower ? nombre.toLowerCase() : nombre}</h3>
      {hasPrice(product) && <span class="card__price">{formatPrice(precio)}</span>}
    </div>
    <p class="card__meta">{lower ? tipo.toLowerCase() : tipo} · {alto_mm} mm</p>
  </div>
</article>
