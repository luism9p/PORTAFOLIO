---
// <img> responsive con srcset WebP generado por scripts/optimize-images.mjs
import manifest from '../data/image-manifest.json';
const { base, alt = '', sizes = '100vw', eager = false, class: cls } = Astro.props;
const m = manifest[base];
if (!m) throw new Error(`Imagen no encontrada en el manifest: ${base}`);
const root = import.meta.env.BASE_URL.replace(/\/$/, '');
const srcset = m.widths.map((w) => `${root}/img/${base}-${w}.webp ${w}w`).join(', ');
const src = `${root}/img/${base}-${m.widths[m.widths.length - 1]}.webp`;
---
<img
  src={src}
  srcset={srcset}
  sizes={sizes}
  width={m.width}
  height={m.height}
  alt={alt}
  class={cls}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
