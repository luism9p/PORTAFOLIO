---
import '../../styles/global.css';
import '../../styles/product.css';
import Base from '../../layouts/Base.astro';
import Announcement from '../../components/Announcement.astro';
import Header from '../../components/Header.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductInfo from '../../components/ProductInfo.astro';
import ProductAccordions from '../../components/ProductAccordions.astro';
import StoryRow from '../../components/StoryRow.astro';
import SplitVideos from '../../components/SplitVideos.astro';
import ProductFaq from '../../components/ProductFaq.astro';
import SpecSheet from '../../components/SpecSheet.astro';
import RelatedProducts from '../../components/RelatedProducts.astro';
import Footer from '../../components/Footer.astro';
import { products, sections, hasPrice, formatPrice, priceMessage, interestMessage, orderMessage } from '../../lib/products';
import { waLink } from '../../lib/links';

// Plantilla dinámica: una página estática por producto de src/data/products.json.
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const title = `${product.nombre} · ${product.tipoDetalle} | FlowHive`;
// Bloque "marca" + sobrescrituras del producto (videoHero, videoSplit, faq, ficha).
const sec = sections(product);
const consultHref = waLink(priceMessage(product));
const orderHref = waLink(orderMessage(product));
---
<Base title={title} description={product.descripcion} bodyClass="pdp" producto={product.nombre}>
  <Announcement>colección costa norte · hecha a mano en lobitos</Announcement>
  <Header solid mensaje={interestMessage(product)} />
  <main class="pdp__main">
    <div class="pdp__grid">
      <ProductGallery product={product} />
      <aside class="pdp__side">
        <ProductInfo product={product} />
        <ProductAccordions product={product} />
      </aside>
    </div>

    <StoryRow hero={sec.hero} unica={sec.unica} />
    <SplitVideos split={sec.split} />
    <ProductFaq saber={sec.saber} />
    <SpecSheet ficha={sec.ficha} product={product} />

    <RelatedProducts product={product} />
  </main>
  <Footer base="/" />

  <!-- Barra de compra fija: aparece cuando la tarjeta de compra sale de la pantalla -->
  <div class="stickybuy" data-buybar aria-label={`Pedir ${product.nombre}`}>
    <div class="stickybuy__info">
      <p class="stickybuy__name">{product.nombre}</p>
      <p class="stickybuy__price">
        {hasPrice(product)
          ? formatPrice(product.precio)
          : consultHref ? <a href={consultHref} data-wa-ubicacion="barra_compra" target="_blank" rel="noopener">consultar precio</a> : 'consultar precio'}
      </p>
    </div>
    {orderHref && <a class="pbtn pbtn--primary stickybuy__btn" data-wa-link data-wa-ubicacion="ficha" href={orderHref} target="_blank" rel="noopener">pedir por whatsapp</a>}
  </div>

  <script>
    import { waLink } from '../../lib/links';
    document.documentElement.classList.add('has-js');
    const mobile = window.matchMedia('(max-width: 899px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Galería: miniaturas con fade (escritorio) / swipe con puntos (móvil) ──
    const gal = document.querySelector<HTMLElement>('[data-gallery]');
    if (gal) {
      const slides = gal.querySelector<HTMLElement>('[data-slides]')!;
      const items = [...slides.querySelectorAll<HTMLElement>('.gal__slide')];
      const thumbs = [...gal.querySelectorAll<HTMLButtonElement>('.gal__thumb')];
      const dots = [...gal.querySelectorAll<HTMLButtonElement>('.gal__dot')];
      let current = 0;
      const setActive = (i: number, scroll = false) => {
        current = Math.max(0, Math.min(items.length - 1, i));
        items.forEach((el, k) => el.classList.toggle('is-active', k === current));
        thumbs.forEach((el, k) => { el.classList.toggle('is-active', k === current); el.setAttribute('aria-pressed', String(k === current)); });
        dots.forEach((el, k) => { el.classList.toggle('is-active', k === current); el.setAttribute('aria-current', String(k === current)); });
        if (scroll && mobile.matches) slides.scrollTo({ left: current * slides.clientWidth, behavior: 'smooth' });
      };
      thumbs.forEach((b, i) => b.addEventListener('click', () => setActive(i)));
      dots.forEach((b, i) => b.addEventListener('click', () => setActive(i, true)));
      slides.addEventListener('scroll', () => {
        if (!mobile.matches) return;
        const i = Math.round(slides.scrollLeft / (slides.clientWidth || 1));
        if (i !== current) setActive(i);
      }, { passive: true });
      slides.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { setActive(current + 1, true); e.preventDefault(); }
        if (e.key === 'ArrowLeft') { setActive(current - 1, true); e.preventDefault(); }
      });
    }

    // ── Variante: actualiza el nombre y el mensaje de WhatsApp (botón de la tarjeta y barra fija) ──
    const info = document.querySelector<HTMLElement>('[data-product]');
    const waLinks = document.querySelectorAll<HTMLAnchorElement>('[data-wa-link]');
    const label = info?.dataset.variantLabel ?? '';
    const buildMessage = (variant?: string) =>
      `${info?.dataset.msg}${variant && label ? ` (${label}: ${variant})` : ''}`;
    document.querySelectorAll<HTMLInputElement>('[data-variants] input').forEach((input) => {
      input.addEventListener('change', () => {
        const nameEl = document.querySelector('[data-variant-name]');
        if (nameEl) nameEl.textContent = input.value;
        const href = waLink(buildMessage(input.value));
        if (href) waLinks.forEach((a) => (a.href = href));
      });
    });

    // ── Barra de compra fija: visible mientras la tarjeta de compra no se ve ──
    // También se oculta cuando el footer entra en pantalla, para no tapar su contenido.
    const bar = document.querySelector<HTMLElement>('[data-buybar]');
    const footer = document.querySelector<HTMLElement>('.footer');
    if (bar && info && 'IntersectionObserver' in window) {
      let cardVisible = true;
      let footerVisible = false;
      const sync = () => bar.classList.toggle('is-visible', !cardVisible && !footerVisible);
      new IntersectionObserver(([e]) => { cardVisible = e.isIntersecting; sync(); }).observe(info);
      if (footer) new IntersectionObserver(([e]) => { footerVisible = e.isIntersecting; sync(); }).observe(footer);
    }

    // ── Videos: se reproducen en pantalla y se pausan al salir. Son loops suaves, así que se ──
    // ── reproducen también con prefers-reduced-motion (esa preferencia solo quita el fade del texto). ──
    // Si play() falla, el poster se queda visible (el <video> pausado lo muestra).
    const vids = [...document.querySelectorAll<HTMLVideoElement>('video[data-vid]')];
    const playVideo = (v: HTMLVideoElement) => {
      v.muted = true; // algunos navegadores solo permiten autoplay si la propiedad (no solo el atributo) está en true
      v.play().catch((err) => console.warn('video', v.getAttribute('src'), err));
    };
    vids.forEach((v) => v.addEventListener('error', () => console.warn('video: no se pudo cargar', v.getAttribute('src'), v.error)));
    if ('IntersectionObserver' in window) {
      const vio = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) playVideo(v);
          else v.pause();
        });
      }, { threshold: 0.25 });
      vids.forEach((v) => vio.observe(v));
    } else {
      vids.forEach(playVideo);
    }

    // ── Texto sobre video: fade-in al entrar en pantalla ──
    const reveals = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
    if (reduceMotion || !('IntersectionObserver' in window)) {
      reveals.forEach((el) => el.classList.add('is-in'));
    } else {
      const rio = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); rio.unobserve(e.target); } });
      }, { threshold: 0.35 });
      reveals.forEach((el) => rio.observe(el));
    }
  </script>
</Base>
